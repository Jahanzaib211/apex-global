// ── module: billing ────────────────────────────────────────────────────────
// Quotes, invoices, payments and subscriptions. The schema is intentionally
// small — the goal is the operational loop (issue invoice → customer pays →
// webhook reconciles), not a full accounting system.

// Locked counter rows for sequential references (INV-0001, QT-0001). One row
// per (model, prefix); every allocation takes a SELECT FOR UPDATE inside a
// transaction, so two operators saving at the same instant cannot mint the
// same number.
model Sequence {
  key   String @id // "invoice:INV" | "quote:QT"
  value Int    @default(0)

  @@map("sequences")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PROCESSING
  PAID
  FAILED
  CANCELLED
  OVERDUE
  WRITE_OFF
}

enum PricingItemKind {
  SERVICE
  PRODUCT
  CUSTOM
}

// Admin-managed price modules. The operator picks one from the invoice/quote
// editor and its values pre-fill the line item (still editable per invoice).
// `Service` and `SaasProduct` rows with a known price are unioned into the
// same picker at query time — this table holds ad-hoc catalogue entries that
// are not (or not yet) published services/products.
model PricingItem {
  id   String          @id @default(cuid())
  kind PricingItemKind @default(CUSTOM)

  slug String @unique
  name String

  // Shown as the line-item description when the operator picks this item.
  description String?

  // Minor units. Null means "contact us" — the operator types an amount.
  defaultUnitAmount Int?
  defaultCurrency   String @default("USD")

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("pricing_items")
}

model Quote {
  id     String      @id @default(cuid())
  number String      @unique // QT-0001

  status QuoteStatus @default(DRAFT)

  customerName  String
  customerEmail String
  companyName   String?

  lineItems  Json // [{ description, quantity, unitAmount, currency }]
  subtotalAmount Int
  taxAmount      Int @default(0)
  totalAmount    Int
  currency       String @default("USD")

  notes   String?
  validUntil DateTime?

  // Link back to the lead this quote was generated against, so attribution
  // reporting can roll spend → lead → quote → invoice → revenue.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // What this quote is selling. Either a service (modular engagement) or a
  // product (SaaS). Exactly one is set.
  serviceSlug String?
  productSlug  String?

  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  invoices Invoice[]

  @@index([status, createdAt])
  @@map("quotes")
}

model Invoice {
  id     String        @id @default(cuid())
  number String        @unique // INV-0001

  status InvoiceStatus @default(DRAFT)

  customerName  String
  customerEmail String
  companyName   String?

  subtotalAmount Int
  taxAmount      Int @default(0)
  totalAmount    Int
  currency       String @default("USD")

  notes String?

  lineItems Json? // [{ description, quantity, unitAmount, currency }]

  // Link back to the originating quote, if any.
  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  // Lead attribution — same purpose as the link on Quote.
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  serviceSlug String?
  productSlug  String?

  // Payment reconciliation fields, populated by the Hyperswitch webhook.
  paymentProvider String? // "hyperswitch" | "manual"
  paymentRef      String? // gateway payment id
  paidAt          DateTime?

  // Hosted payment link, for invoices settled outside the portal (emailed to a
  // customer who has no portal login). Generated on demand from the console;
  // the webhook reconciles it through the same `metadata.invoiceId` path as a
  // portal payment.
  paymentLinkUrl       String?
  paymentLinkExpiresAt DateTime?

  dueDate DateTime?
  sentAt DateTime?

  // Last time a payment reminder was emailed — dunning is rate-limited on this.
  lastReminderAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([dueDate])
  @@map("invoices")
}
