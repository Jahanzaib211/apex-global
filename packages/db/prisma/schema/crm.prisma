// ── module: crm ─────────────────────────────────────────────────────────────
// The commercial spine: every enquiry, where it came from, and what happened
// to it. Attribution is captured at the moment of submission — reconstructing
// it later is impossible.

enum LeadStage {
  NEW
  QUALIFIED
  OPPORTUNITY
  CUSTOMER
  LOST
}

enum LeadSourceType {
  FORM
  PHONE_CLICK
  WHATSAPP_CLICK
  EMAIL_CLICK
  DEMO_REQUEST
  REFERRAL
  MANUAL
}

model Lead {
  id    String    @id @default(cuid())
  stage LeadStage @default(NEW)

  // ── Who ───────────────────────────────────────────────────────────────
  name        String
  email       String
  phone       String?
  whatsapp    String?
  companyName String?
  jobTitle    String?
  country     String?
  countryCode String?
  companySize String?

  // ── What they want ────────────────────────────────────────────────────
  interestType String? // "solution" | "product" | "general" | "career"
  interestSlug String?
  requirements String? @db.Text
  budgetBand   String?
  timeline     String?
  message      String? @db.Text

  sourceType LeadSourceType @default(FORM)

  // Which Apex property captured this enquiry: "tech", "apex-group",
  // "apex-holdings", "apex-outsourcing", "apex-tours".
  //
  // The group runs five public sites into this one pipeline. Without a source
  // brand every site's demand lands in one undifferentiated pile, and neither
  // "which site is actually producing pipeline" nor "route this to the team
  // that owns it" can be answered. Defaults to "tech" so rows written before
  // the group sites were wired keep their true origin.
  sourceSite String @default("tech")

  // ── Handling ──────────────────────────────────────────────────────────
  ownerId String?
  owner   User?   @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  qualifiedAt DateTime?
  convertedAt DateTime?
  lostAt      DateTime?
  lostReason  String?
  valueAmount Int?
  valueCurrency String @default("USD")
  nextFollowUpAt DateTime?

  // ── AI assist ─────────────────────────────────────────────────────────
  // Advisory only. Scores never auto-action, auto-reply or auto-discard a
  // lead; a human decides and the audit log records who.
  aiSummary   String? @db.Text
  aiScore     Int?
  aiScoredAt  DateTime?
  aiModel     String?

  attribution Attribution?
  activities  LeadActivity[]
  demoRequest DemoRequest?
  quotes      Quote[]
  invoices    Invoice[]
  tickets     Ticket[]
  projects    Project[] @relation("LeadProjects")
  portalAccounts PortalAccount[]

  // Deduplication window key: same site + same email + same day. Prevents a
  // double-tap on a slow mobile connection from creating two leads and two
  // notifications.
  //
  // The site is part of the key on purpose. Someone who enquires at Apex Tours
  // and at Apex Tech on the same day has two distinct intents for two
  // different businesses; collapsing them into one lead would silently discard
  // the second and hand it to the wrong team.
  dedupeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, createdAt])
  @@index([email])
  @@index([ownerId, stage])
  @@index([createdAt])
  @@index([sourceSite, createdAt])
  @@map("leads")
}

// First-touch marketing attribution, written in the same transaction as the
// lead. This is what makes "spend -> lead -> customer -> revenue" answerable.
model Attribution {
  id     String @id @default(cuid())
  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmTerm     String?
  utmContent  String?

  gclid  String?
  fbclid  String?
  msclkid String?

  referrer    String?
  landingPath String?
  currentPath String?

  userAgent String?
  ipHash    String? // hashed, never the raw address
  country   String?

  // Consent state at submission time, so we can prove why a tag did or did
  // not fire for this visitor.
  consentAnalytics Boolean @default(false)
  consentMarketing Boolean @default(false)

  // Server-side conversion delivery. Browser-side events are lost to ad
  // blockers and ITP at a high rate; these are the copies that survive.
  metaCapiSentAt   DateTime?
  googleAdsSentAt  DateTime?
  conversionErrors Json?

  createdAt DateTime @default(now())

  @@index([utmCampaign])
  @@index([utmSource, utmMedium])
  @@map("attributions")
}

model LeadActivity {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  type    String // "note" | "stage_change" | "assignment" | "email" | "call" | "ai_summary"
  summary String
  detail  String? @db.Text
  meta    Json?

  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

// Campaign spend, entered or synced, so attribution reporting can divide
// money by outcomes rather than guessing.
model CampaignSpend {
  id       String @id @default(cuid())
  platform String // "google-ads" | "meta" | "linkedin"
  campaign String

  periodStart DateTime
  periodEnd   DateTime

  amount   Int // minor units
  currency String @default("USD")

  impressions Int?
  clicks      Int?

  source String @default("manual") // "manual" | "api-sync"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, campaign, periodStart, periodEnd])
  @@index([platform, periodStart])
  @@map("campaign_spend")
}

// ── Marketing module ───────────────────────────────────────────────────────
// A named, addressable campaign. `slug` is the value passed in the
// `utm_campaign` query parameter and matched against Attribution on lead
// submission, so the spend→lead→customer join is one SQL query away.
model Campaign {
  id     String @id @default(cuid())
  slug   String @unique // matches utm_campaign
  status String  @default("active") // "active" | "paused" | "completed"

  name        String
  channel     String  // "google-ads" | "meta" | "linkedin" | "email" | "organic"
  objective   String? // "leads" | "demos" | "traffic"

  // The landing page URL this campaign drives traffic to. Required for paid
  // campaigns so the spend can be tied to a destination.
  landingPath String?

  // Budget the campaign is allowed to spend. The attribution report surfaces
  // actual spend against this number so over-spend is visible at a glance.
  budgetAmount   Int?
  budgetCurrency String @default("USD")

  // Linked SaaS product or service, optional. A campaign selling
  // "Architecture & Design" sets interestSlug here so attribution can be
  // segmented by surface without parsing the landing path.
  interestSlug String?

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, channel])
  @@map("campaigns")
}

// Aggregate roll-up of attribution for a campaign over a date range.
// Computed on a schedule (see modules/marketing/README.md) and cached so the
// attribution report renders in one query rather than scanning every lead.
model AttributionReport {
  id         String   @id @default(cuid())
  campaignSlug String
  periodStart DateTime
  periodEnd   DateTime

  leads        Int
  qualified    Int
  opportunities Int
  customers    Int

  revenueAmount   Int // sum of Lead.valueAmount for customers, in minor units
  revenueCurrency String @default("USD")

  spendAmount   Int // sum of CampaignSpend for the campaign+period, in minor units
  spendCurrency String @default("USD")

  createdAt DateTime @default(now())

  @@unique([campaignSlug, periodStart, periodEnd])
  @@index([campaignSlug, periodEnd])
  @@map("attribution_reports")
}
