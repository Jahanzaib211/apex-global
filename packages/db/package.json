{
  "name": "@apex/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums.ts"
  },
  "prisma": {
    "schema": "prisma/schema",
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "//env": "The workspace keeps one .env at the repo root; Prisma only looks in its own package dir, so every DB command is wrapped.",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "push": "dotenv -e ../../.env -- prisma db push --skip-generate",
    "seed": "dotenv -e ../../.env -- prisma db seed",
    "audit": "dotenv -e ../../.env -- tsx prisma/audit.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "eslint src prisma",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .turbo node_modules generated",
    "seed:admin": "dotenv -e ../../.env -- tsx prisma/seed-admin.ts",
    "provision:master": "dotenv -e ../../.env -- tsx prisma/provision-master-admin.ts",
    "invite": "dotenv -e ../../.env -- tsx prisma/invite-portal-user.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@apex/config": "workspace:*",
    "@prisma/engines": "6.19.0",
    "@prisma/engines-version": "7.1.1-3.c2990dca591cba766e3b7ef5d9e8a84796e47ab7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
