{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=4892 pnpm --filter @apex/web start",
      "startServerReadyPattern": "Ready in|started server on",
      "startServerReadyTimeout": 60000,
      "url": [
        "http://localhost:4892/",
        "http://localhost:4892/solutions/cloud-solutions",
        "http://localhost:4892/technology",
        "http://localhost:4892/lp/cloud-migration"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "emulatedFormFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2000
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.05
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ],
            "first-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1500
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 184320
              }
            ],
            "resource-summary:image:size": [
              "warn",
              {
                "maxNumericValue": 512000
              }
            ],
            "resource-summary:font:size": [
              "error",
              {
                "maxNumericValue": 153600
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 0
              }
            ],
            "unused-javascript": [
              "warn",
              {
                "maxLength": 1
              }
            ],
            "uses-responsive-images": "error",
            "uses-text-compression": "error"
          }
        },
        {
          "matchingUrlPattern": "^(?!.*\\/lp\\/).*$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
