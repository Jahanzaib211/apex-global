# ─────────────────────────────────────────────────────────────
# Apex Global Tech Solution — environment contract
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Environment: development | staging | production
# NODE_ENV is set by the tooling (next, vitest). Setting it here breaks
# production builds, which then fall back to the dev error page.
# NODE_ENV=
NEXT_PUBLIC_ENV=development

# Public URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:4300
CONSOLE_URL=http://localhost:4301

# ── Datastores ───────────────────────────────────────────────
DATABASE_URL=postgresql://apex:apex_dev_password@localhost:5437/apex?schema=public
REDIS_URL=redis://localhost:6381

# ── Object storage (MinIO / any S3) ──────────────────────────
S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_BUCKET=apex-media
S3_ACCESS_KEY=apex_minio
S3_SECRET_KEY=change_me_in_production
S3_PUBLIC_URL=http://localhost:9020/apex-media

# ── Search ───────────────────────────────────────────────────
MEILI_HOST=http://localhost:7701
MEILI_MASTER_KEY=change_me_in_production

# ── Auth (Auth.js v5) ────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:4301
# AES-256-GCM key for the integrations vault. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Email (outbound notifications) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Apex Global Tech Solution <no-reply@example.com>"
LEAD_NOTIFY_TO=

# ── Anti-spam ────────────────────────────────────────────────
# Cloudflare Turnstile. Empty in development = challenge skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics & attribution (all optional, consent-gated) ────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── AI providers ─────────────────────────────────────────────
# Keys are normally entered in the console UI and stored encrypted in the DB.
# These env values are a bootstrap fallback only.
AI_DEFAULT_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# ── Contact details rendered on the site ─────────────────────
# Overridable at runtime from console settings; these are the seed defaults.
NEXT_PUBLIC_CONTACT_PHONE=+92-42-3229-4384
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
