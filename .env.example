# ─────────────────────────────────────────────────────────────
# Apex Global Tech Solution — environment contract
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Environment: development | staging | production
# NODE_ENV is set by the tooling (next, vitest). Setting it here breaks
# production builds, which then fall back to the dev error page.
# NODE_ENV=
NEXT_PUBLIC_ENV=development

# Public URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:4300
CONSOLE_URL=http://localhost:4301

# ── Datastores ───────────────────────────────────────────────
DATABASE_URL=postgresql://apex:apex_dev_password@localhost:5437/apex?schema=public
REDIS_URL=redis://localhost:6381

# ── Object storage (MinIO / any S3) ──────────────────────────
S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_BUCKET=apex-media
S3_ACCESS_KEY=apex_minio
S3_SECRET_KEY=change_me_in_production
S3_PUBLIC_URL=http://localhost:9020/apex-media

# ── Search ───────────────────────────────────────────────────
MEILI_HOST=http://localhost:7701
MEILI_MASTER_KEY=change_me_in_production

# ── Auth (Auth.js v5) ────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:4301
# AES-256-GCM key for the integrations vault. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Email (outbound notifications) ───────────────────────────
# OAuth providers (portal sign-in). Google: Google Cloud Console →
# APIs & Services → Credentials → OAuth client (Web application). Authorised
# redirect URI — the provider segment comes BEFORE `callback`, matching the
# route at (portal)/portal/(unauth)/auth/[provider]/callback:
#   https://tech.apexgroupcompanies.com/portal/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft / Entra ID. Redirect URI:
#   https://tech.apexgroupcompanies.com/portal/auth/microsoft/callback
AZURE_AD_TENANT_ID=common
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Apex Global Tech Solution <no-reply@example.com>"
LEAD_NOTIFY_TO=

# ── Anti-spam ────────────────────────────────────────────────
# Cloudflare Turnstile. Empty in development = challenge skipped.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cache invalidation (console → web) ───────────────────────
# The console and the web app are separate processes, so publishing in the
# console has to purge the web app's cache over HTTP. Both read the same
# secret. Unset = the web app answers 503 and content waits for ISR.
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=
WEB_ORIGIN=http://127.0.0.1:4300

# ── Analytics & attribution (all optional, consent-gated) ────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ── AI providers ─────────────────────────────────────────────
# Keys are normally entered in the console UI and stored encrypted in the DB.
# These env values are a bootstrap fallback only.
AI_DEFAULT_PROVIDER=minimax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=
OLLAMA_BASE_URL=http://localhost:11434

# ── Inbound webhooks ─────────────────────────────────────────
# Signing secrets for the two webhook receivers. Both routes REFUSE unsigned
# payloads: with no secret set they answer 503 rather than trusting the body.
# Register the same value in the provider's webhook settings.
#   Hyperswitch → https://<site>/api/webhooks/hyperswitch
#   Twenty CRM  → https://<site>/api/webhooks/twenty
# Hyperswitch may also carry its secret in the integration config blob.
HYPERSWITCH_WEBHOOK_SECRET=
TWENTY_WEBHOOK_SECRET=

# ── Group site lead intake ───────────────────────────────────
# Shared secret for /api/leads/partner, the endpoint the four other Apex
# properties (apex-group, apex-holdings, apex-outsourcing, apex-tours) sign
# and post their contact forms to. The same value must be set in each of
# those apps' own .env as PARTNER_LEAD_SECRET.
#
# Server-to-server only — this must never reach a browser bundle. Generate
# with: openssl rand -hex 32
# Unset means the endpoint refuses every request rather than accepting
# unsigned ones.
PARTNER_LEAD_SECRET=

# ── Contact details rendered on the site ─────────────────────
# Overridable at runtime from console settings; these are the seed defaults.
NEXT_PUBLIC_CONTACT_PHONE=+92-42-3229-4384
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=

# ── Chatwoot (self-hosted live chat — the real-human layer) ──────
# Compose: infra/docker-compose.chatwoot.yml. Set the non-empty values here
# or export them. CHATWOOT_SECRET_KEY_BASE: `openssl rand -hex 64`.
CHATWOOT_TAG=latest
CHATWOOT_SECRET_KEY_BASE=
CHATWOOT_POSTGRES_USERNAME=chatwoot
CHATWOOT_POSTGRES_PASSWORD=
CHATWOOT_REDIS_PASSWORD=
CHATWOOT_FRONTEND_URL=

# Optional override for the live-chat host, e.g. to point the sites at a
# staging Chatwoot. Leave blank to use https://chat.apexgroupcompanies.com.
#
# There is deliberately no token here. Each site opens its own Chatwoot inbox
# so the agent can see which brand a conversation arrived on, and every app
# builds from this one file — so a NEXT_PUBLIC_ token here would necessarily be
# the same value everywhere and funnel all five brands into one inbox. The
# per-site tokens live in packages/site-kit/src/chatwoot.ts; they are public by
# design (the widget ships them to the browser) and only name an inbox.
NEXT_PUBLIC_CHATWOOT_URL=
