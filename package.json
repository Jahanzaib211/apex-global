{
  "name": "apex-global",
  "version": "0.1.0",
  "private": true,
  "description": "Apex Global Tech Solution — global SaaS and technology platform",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @apex/db generate",
    "db:migrate": "pnpm --filter @apex/db migrate",
    "db:push": "pnpm --filter @apex/db push",
    "db:seed": "pnpm --filter @apex/db seed",
    "db:studio": "pnpm --filter @apex/db studio",
    "services:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "services:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "services:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "services:ps": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "smoke": "node scripts/smoke-test.mjs",
    "audit:credibility": "pnpm --filter @apex/db run audit",
    "db:seed:admin": "pnpm --filter @apex/db run seed:admin",
    "provision:hyperswitch": "node scripts/provision-hyperswitch.mjs",
    "repo:graph": "python3 scripts/generate-repo-graph.py",
    "test:coverage": "turbo test -- --coverage"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "postcss": "^8.5.26",
      "nanoid": "^3.3.18",
      "sharp": "^0.35.3",
      "vite": "^8.2.1"
    },
    "//overrides": "Transitive packages nothing in this repo declares directly, pinned because osv-scanner found CVEs in the versions their parents resolve to. Each entry is the lowest fixed release in the same major, so it is a patch bump for the dependent, not a version it has to know about. Remove an entry once every parent has moved past it on its own."
  },
  "devDependencies": {
    "@apex/db": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "15.5.23",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "^8.2.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}
