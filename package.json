{
  "name": "apex-global",
  "version": "0.1.0",
  "private": true,
  "description": "Apex Global Tech Solution \u2014 global SaaS and technology platform",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @apex/db generate",
    "db:migrate": "pnpm --filter @apex/db migrate",
    "db:push": "pnpm --filter @apex/db push",
    "db:seed": "pnpm --filter @apex/db seed",
    "db:studio": "pnpm --filter @apex/db studio",
    "services:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "services:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "services:logs": "docker compose --env-file .env -f infra/docker-compose.yml logs -f",
    "services:ps": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "smoke": "node scripts/smoke-test.mjs",
    "audit:credibility": "pnpm --filter @apex/db run audit",
    "db:seed:admin": "pnpm --filter @apex/db run seed:admin",
    "provision:hyperswitch": "node scripts/provision-hyperswitch.mjs",
    "repo:graph": "python3 scripts/generate-repo-graph.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.65.0",
    "vitest": "^2.1.8"
  }
}
