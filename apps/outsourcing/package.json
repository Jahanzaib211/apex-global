{
  "name": "@apex/outsourcing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "dotenv -e ../../.env -- next build",
    "start": "next start -p ${PORT:-3100}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rm -rf .next .next/standalone/.next"
  },
  "dependencies": {
    "@apex/motion": "workspace:*",
    "@apex/site-kit": "workspace:*",
    "lucide-react": "^0.460.0",
    "next": "15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@apex/config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "20.16.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.20",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.13",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
