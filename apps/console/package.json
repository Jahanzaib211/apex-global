{
  "name": "@apex/console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p ${PORT:-4301}",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start -p ${PORT:-4301}",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@apex/ai": "workspace:*",
    "@apex/auth": "workspace:*",
    "@apex/db": "workspace:*",
    "@apex/integrations": "workspace:*",
    "@apex/module-kit": "workspace:*",
    "@apex/ui": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.0.8",
    "ioredis": "^6.0.0",
    "jose": "^5.9.6",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@apex/config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^8.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
