{
  "name": "@apex/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- next dev -p ${PORT:-4300}",
    "build": "dotenv -e ../../.env -- next build",
    "start": "dotenv -e ../../.env -- next start -p ${PORT:-4300}",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo node_modules"
  },
  "dependencies": {
    "@apex/ai": "workspace:*",
    "@apex/auth": "workspace:*",
    "@apex/db": "workspace:*",
    "@apex/integrations": "workspace:*",
    "@apex/site-kit": "workspace:*",
    "@apex/ui": "workspace:*",
    "@juspay-tech/hyper-js": "^2.1.0",
    "@juspay-tech/react-hyper-js": "^2.3.0",
    "@types/pg": "^8.21.0",
    "motion": "^13.0.0",
    "next": "15.5.23",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@apex/config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^8.0.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
